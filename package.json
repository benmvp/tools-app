{
  "name": "codemata",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:test": "turbo run build:test",
    "lint": "turbo run lint && pnpm lint:agents",
    "lint:agents": "biome check --files-ignore-unknown=true --no-errors-on-unmatched .agents",
    "test": "turbo run test",
    "format": "turbo run format && pnpm format:agents",
    "format:agents": "biome format --write --files-ignore-unknown=true --no-errors-on-unmatched .agents",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "@ungap/structured-clone": "^1.3.1"
    }
  }
}
